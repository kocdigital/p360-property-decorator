{
  "compilerOptions": {
    "target": "es2018",
    "module": "esnext",
    "strict": false,
    "alwaysStrict": false,
    "strictFunctionTypes": false,
    "importHelpers": true,
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "sourceMap": false,
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable",
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
  ]
}